{
  "expo": {
    "name": "ortakbul.org",
    "slug": "ortakbul",
    "scheme": "ortakbul",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": { "supportsTablet": true, "bundleIdentifier": "org.ortakbul.app" },
    "android": { "package": "org.ortakbul.app" },
    "web": { "bundler": "metro" },
    "plugins": ["expo-router", "expo-secure-store"],
    "extra": {
      "apiUrl": "https://ortakbul-api.onrender.com/api"
    }
  }
}
