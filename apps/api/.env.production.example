# ortakbul.org — API PRODUCTION ortam değişkenleri
# Bu dosyayı sunucuda .env olarak kopyalayıp değerleri DOLDUR.

# --- Veritabanı (PostgreSQL ŞART; paylaşımlı hosting'te yoksa Neon/Render ücretsiz Postgres kullan) ---
DATABASE_URL="postgresql://KULLANICI:SIFRE@HOST:5432/ortakbul?schema=public&sslmode=require"

API_PORT=4000
NODE_ENV=production

# --- CORS: canlı web adresin(ler)i (virgülle) ---
WEB_ORIGIN="https://ortakbul.org,https://www.ortakbul.org"

# --- JWT gizli anahtarları: UZUN, RASTGELE değerlerle DEĞİŞTİR (örn. `openssl rand -hex 32`) ---
JWT_ACCESS_SECRET="BURAYA_UZUN_RASTGELE_DEGER"
JWT_REFRESH_SECRET="BURAYA_BASKA_UZUN_RASTGELE_DEGER"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# --- Gizli admin yolu (tahmin edilmesin diye değiştirebilirsin) ---
ADMIN_PATH="/y-panel-8f3a"
SEED_ADMIN_EMAIL="admin@ortakbul.org"
SEED_ADMIN_PASSWORD="GUCLU_BIR_SIFRE_GIR"

FX_USD_TRY=41.0

# --- 3. parti (anahtarlar gelince doldur; boşsa güvenli dev-mock çalışır) ---
MAIL_PROVIDER="smtp"
# SMTP_HOST= SMTP_PORT= SMTP_USER= SMTP_PASS=
SMS_PROVIDER="netgsm"
# NETGSM_USER= NETGSM_PASS=
PAYMENT_DEFAULT_PROVIDER="iyzico"
# IYZICO_API_KEY= IYZICO_SECRET=
