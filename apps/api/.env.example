# API ortam değişkenleri — kopyala: cp .env.example .env
# (Prisma ve seed bu dosyadan okur; kök .env ile aynı değerleri kullanabilirsin.)
DATABASE_URL="postgresql://ortakbul:ortakbul@localhost:5432/ortakbul?schema=public"
REDIS_URL="redis://localhost:6379"

API_PORT=4000
NODE_ENV=development
WEB_ORIGIN="http://localhost:3000"

JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

ADMIN_PATH="/y-panel-8f3a"

SEED_ADMIN_EMAIL="admin@ortakbul.org"
SEED_ADMIN_PASSWORD="Admin!2026"

FX_USD_TRY=41.0

MAIL_PROVIDER="smtp"
SMS_PROVIDER="netgsm"

# Ödeme — iyzico (resmi başvuru yapıldı, API bekleniyor).
# Anahtarlar gelince aşağıyı doldur; sistem otomatik gerçek iyzico'ya geçer.
# Boş bırakılırsa güvenli dev-mock modunda çalışır.
PAYMENT_DEFAULT_PROVIDER="iyzico"
IYZICO_API_KEY=""
IYZICO_SECRET=""
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"
# Canlıya geçince: https://api.iyzipay.com
