# ---- Ortak (root) ortam değişkenleri — kopyala: cp .env.example .env ----

# Veritabanı (docker-compose ile uyumlu)
DATABASE_URL="postgresql://ortakbul:ortakbul@localhost:5432/ortakbul?schema=public"
REDIS_URL="redis://localhost:6379"

# API
API_PORT=4000
NODE_ENV=development
# Web istemcinin adresi (CORS)
WEB_ORIGIN="http://localhost:3000"

# JWT (production'da güçlü, rastgele değerlerle değiştir)
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Güvenlik: admin panelinin gizli yolu (nav'da görünmez)
ADMIN_PATH="/y-panel-8f3a"

# İlk süper admin (seed)
SEED_ADMIN_EMAIL="admin@ortakbul.org"
SEED_ADMIN_PASSWORD="Admin!2026"

# Döviz (USD dönüşümü) — production'da canlı API
FX_USD_TRY=41.0

# Mail sağlayıcı (SMTP / SendGrid)
MAIL_PROVIDER="smtp"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="ortakbul.org <no-reply@ortakbul.org>"

# SMS sağlayıcı (netgsm / twilio)
SMS_PROVIDER="netgsm"
SMS_API_KEY=""
SMS_API_SECRET=""
SMS_SENDER="ORTAKBUL"

# Ödeme sağlayıcıları
PAYMENT_DEFAULT_PROVIDER="iyzico"   # iyzico | paytr | stripe
IYZICO_API_KEY=""
IYZICO_SECRET=""
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"
PAYTR_MERCHANT_ID=""
PAYTR_MERCHANT_KEY=""
PAYTR_MERCHANT_SALT=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Sosyal giriş (OAuth)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
